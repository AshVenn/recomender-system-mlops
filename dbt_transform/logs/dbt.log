      "tmdb_pipeline"."analytics"."ml_feature_table__dbt_tmp"
  
    as (
      

WITH raw_data AS (
    -- dlt creates this table based on the new resource function name
    SELECT * FROM raw_movies.fetch_rich_movie_data
)

SELECT
    id AS movie_id,
    title,
    -- Cast features to standard numeric types for the ML model
    CAST(popularity AS DOUBLE) AS popularity,
    CAST(budget AS DOUBLE) AS budget,
    CAST(runtime AS DOUBLE) AS runtime,
    CAST(vote_average AS DOUBLE) AS rating
FROM raw_data
-- Clean the data: Machine Learning models crash on NULLs or zeroes in critical fields
WHERE budget > 0 
  AND runtime > 0
  AND vote_average IS NOT NULL
    );
  
  
